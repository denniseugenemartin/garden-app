# Copy this file to `.env` and fill in the values, then restart `npm start`.
# EXPO_PUBLIC_* values are bundled into the app and visible to anyone who inspects it.
# The Supabase publishable key is designed to be public; access is enforced by row level security.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
